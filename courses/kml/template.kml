<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2" xmlns:kml="http://www.opengis.net/kml/2.2" xmlns:atom="http://www.w3.org/2005/Atom">
<Document>
	<name>{{ name }}</name>
	<open>1</open>
	<Style id="boundaries">
		<LineStyle>
			<color>ff00ffff</color>
			<width>2</width>
		</LineStyle>
		<PolyStyle>
			<color>8000ffff</color>
		</PolyStyle>
	</Style>
	<Placemark>
		<name>Start</name>
		<Point>
			<coordinates>{{ start_lon }},{{ start_lat }},0</coordinates>
		</Point>
	</Placemark>
	<Placemark>
		<name>Finish</name>
		<Point>
			<coordinates>{{ finish_lon }},{{ finish_lat }},0</coordinates>
		</Point>
	</Placemark>
	<Placemark>
		<name>Boundaries</name>
		<styleUrl>#boundaries</styleUrl>
		<Polygon>
			<tessellate>1</tessellate>
			<outerBoundaryIs>
				<LinearRing>
					<coordinates>
						{{ polygon_coordinates }}
					</coordinates>
				</LinearRing>
			</outerBoundaryIs>
		</Polygon>
	</Placemark>
</Document>
</kml>
